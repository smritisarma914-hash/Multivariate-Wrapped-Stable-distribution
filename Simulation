# 10.3  RMSE heatmaps
def save_rmse_heatmap(df, dimension, title, filename):
    sub     = df[df["Dimension"] == dimension]
    params  = list(sub["Parameter"].unique())
    methods = list(METHOD_COLS.keys())[::-1]
    ns_num  = SAMPLE_SIZES
    n_labels = [f"n={n}" for n in ns_num]

    fig, axes = plt.subplots(1, len(params),
                              figsize=(3.4 * len(params), 2.6 + 0.3 * len(methods)),
                              facecolor=BG_COL)
    if len(params) == 1:
        axes = [axes]
    fig.suptitle(title, fontsize=11, fontweight="bold", y=1.02)

    for ax, p in zip(axes, params):
        mat = np.full((len(methods), len(ns_num)), np.nan)
        for i, m in enumerate(methods):
            for j, n in enumerate(ns_num):
                v = sub[(sub["Method"] == m) & (sub["n"] == n) & (sub["Parameter"] == p)]["RMSE"]
                if len(v):
                    mat[i, j] = float(v.values[0])

        vmin, vmax = np.nanmin(mat), np.nanmax(mat)
        im = ax.imshow(mat, aspect="auto", cmap="RdYlGn_r", vmin=vmin, vmax=vmax)
        for i in range(len(methods)):
            for j in range(len(ns_num)):
                ax.text(j, i, f"{mat[i, j]:.3f}", ha="center", va="center",
                        fontsize=7.5, color="white", fontweight="bold")
        ax.set_xticks(range(len(ns_num)));    ax.set_xticklabels(n_labels, fontsize=8)
        ax.set_yticks(range(len(methods)));   ax.set_yticklabels(methods, fontsize=8,
                                                                   fontweight="bold")
        ax.set_title(p, fontsize=9, fontweight="bold", pad=4)
        plt.colorbar(im, ax=ax, fraction=0.04, pad=0.04).ax.tick_params(labelsize=7)

    plt.tight_layout()
    path = os.path.join(OUTPUT_DIR, filename)
    plt.savefig(path, dpi=160, bbox_inches="tight", facecolor=BG_COL)
    plt.close()
    print(f"  Saved: {os.path.basename(path)}")


