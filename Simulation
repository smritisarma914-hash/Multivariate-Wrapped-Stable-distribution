}
METHOD_MARKS = {
    "GMM-cf": "s", "CF-MDE": "o", "MLE": "^", "EM": "D", "Nested-EM": "*"
}

BG_COL = "#faf8f2"


def _style_ax(ax, title="", xlabel="Sample size (n)", ylabel=""):
    ax.set_facecolor("white")
    ax.set_title(title, fontsize=10, fontweight="bold", pad=5)
    ax.set_xlabel(xlabel, fontsize=8)
    ax.set_ylabel(ylabel, fontsize=8)
    ax.tick_params(labelsize=7)
    ax.grid(axis="y", color="#e0e0e0", lw=0.5)
    ax.spines[["top", "right"]].set_visible(False)


#  10.1  Per-parameter Bias & RMSE plots (one file per dimension) 
def save_bias_rmse_plots(df, dimension, param_labels, file_prefix):
    """
    One combined figure per dimension:
      rows = [Bias, RMSE],  cols = parameters
    """
    params  = list(param_labels.keys())
    methods = list(METHOD_COLS.keys())
    ns_str  = [str(n) for n in SAMPLE_SIZES]

    ncols = len(params)
    fig, axes = plt.subplots(2, ncols,
                             figsize=(3.2 * ncols, 7.5),
                             facecolor=BG_COL)
    fig.suptitle(f"{dimension} MWS — Bias & RMSE  (B={B_ITER} reps)",
                 fontsize=12, fontweight="bold", y=1.00)

    for row, metric in enumerate(["Bias", "RMSE"]):
        for col, p in enumerate(params):
            ax  = axes[row, col]
            sub = df[(df["Dimension"] == dimension) & (df["Parameter"] == p)]
            for m in methods:
                mv = sub[sub["Method"] == m].sort_values("n")
                ax.plot(ns_str, mv[metric].values,
                        color=METHOD_COLS[m], marker=METHOD_MARKS[m],
                        lw=1.6, ms=5, label=m)
            if metric == "Bias":
                ax.axhline(0, color="#888", lw=0.8, ls="--")
            _style_ax(ax,
                      title=param_labels[p],
                      xlabel="n" if row == 1 else "",
                      ylabel=metric if col == 0 else "")
            if row == 0 and col == 0:
                ax.legend(fontsize=7, framealpha=0.8, loc="best")

    plt.tight_layout(rect=[0, 0, 1, 0.98])
    path = os.path.join(OUTPUT_DIR, f"{file_prefix}_bias_rmse.png")
    plt.savefig(path, dpi=160, bbox_inches="tight", facecolor=BG_COL)
    plt.close()
    print(f"  Saved: {os.path.basename(path)}")


