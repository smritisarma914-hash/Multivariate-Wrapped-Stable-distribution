def save_alpha_comparison(df):
    dims    = ["Univariate", "Bivariate"]
    methods = list(METHOD_COLS.keys())
    ns_str  = [str(n) for n in SAMPLE_SIZES]

    fig, axes = plt.subplots(2, 2, figsize=(11, 7.5), facecolor=BG_COL)
    fig.suptitle("Stability Index α — Bias & RMSE: Univariate vs Bivariate",
                 fontsize=12, fontweight="bold", y=1.00)

    for col, dim in enumerate(dims):
        sub = df[(df["Dimension"] == dim) & (df["Parameter"] == "alpha")]
        for row, metric in enumerate(["Bias", "RMSE"]):
            ax = axes[row, col]
            for m in methods:
                mv = sub[sub["Method"] == m].sort_values("n")
                ax.plot(ns_str, mv[metric].values,
                        color=METHOD_COLS[m], marker=METHOD_MARKS[m],
                        lw=1.6, ms=5.5, label=m)
            if metric == "Bias":
                ax.axhline(0, color="#888", lw=0.8, ls="--")
            _style_ax(ax,
                      title=dim if row == 0 else "",
                      xlabel="n" if row == 1 else "",
                      ylabel=metric if col == 0 else "")
            if row == 0 and col == 0:
                ax.legend(fontsize=7.5, framealpha=0.8)

    plt.tight_layout(rect=[0, 0, 1, 0.98])
    path = os.path.join(OUTPUT_DIR, "mws_alpha_comparison.png")
    plt.savefig(path, dpi=160, bbox_inches="tight", facecolor=BG_COL)
    plt.close()
    print(f"  Saved: {os.path.basename(path)}")


