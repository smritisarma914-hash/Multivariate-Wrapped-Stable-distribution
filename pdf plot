    aspect="equal",
    extent=[-np.pi, np.pi, -np.pi, np.pi],
    cmap="inferno",
    interpolation="bilinear"
)

add_colorbar(fig, im, ax, r"$p_W(\theta)$")

style_2d(
    ax,
    title=rf"MWS Density Heatmap ($\alpha={alpha_val}$)"
)

