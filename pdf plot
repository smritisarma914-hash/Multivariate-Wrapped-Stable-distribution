# MWS DENSITY FUNCTION


def mws_density(theta1,
                theta2,
                alpha=1.5,
                mu=None,
                weights=None,
                directions=None,
                N_trunc=25):
    

    
    # Defaults
    
    if mu is None:
        mu = np.array([0.0, 0.0])

    if weights is None:
        weights = np.array([1.2, 0.8, 0.6, 0.6])

    if directions is None:
        ang = np.array([
            0,
            np.pi / 2,
            np.pi / 4,
            3 * np.pi / 4
        ])

        directions = np.column_stack([
            np.cos(ang),
            np.sin(ang)
        ])

    
    # Frequency grid
    
    nv = np.arange(-N_trunc, N_trunc + 1)

    n1g, n2g = np.meshgrid(nv, nv, indexing="ij")

    n1 = n1g.ravel()
    n2 = n2g.ravel()

    
    # Spectral exponent Lambda(n)
    
    inner = (
        np.outer(n1, directions[:, 0]) +
        np.outer(n2, directions[:, 1])
    )

    Lambda = (np.abs(inner) ** alpha) @ weights

    
    # Characteristic function
    
    phase = n1 * mu[0] + n2 * mu[1]

    phi_re = np.exp(-Lambda) * np.cos(phase)
    phi_im = np.exp(-Lambda) * np.sin(phase)

    
    # Fourier inversion
    
    angle = (
        np.outer(theta1, n1) +
        np.outer(theta2, n2)
    )


    terms = (
        phi_re[None, :] * np.cos(angle) +
        phi_im[None, :] * np.sin(angle)
    )

    p = np.sum(terms, axis=1)

    p = p / (2 * np.pi) ** 2

    return np.real(p)



# STYLING FUNCTIONS


def style_2d(ax, title=""):

    ax.set_facecolor(DARK)

    ax.set_xlabel(r"$\theta_1$", color="white", fontsize=11)
    ax.set_ylabel(r"$\theta_2$", color="white", fontsize=11)

    ax.set_title(title, color="white", fontsize=11, pad=8)

    ax.tick_params(colors="white")

    for sp in ax.spines.values():
        sp.set_edgecolor("#444")

    ax.set_xticks(PI_TICKS)
    ax.set_xticklabels(PI_LABELS, color="white", fontsize=8)

    ax.set_yticks(PI_TICKS)
    ax.set_yticklabels(PI_LABELS, color="white", fontsize=8)


def add_colorbar(fig, mappable, ax, label=""):

    cb = fig.colorbar(
        mappable,
        ax=ax,
        fraction=0.046,
        pad=0.04
    )

    cb.ax.yaxis.set_tick_params(
        color="white",
        labelcolor="white"
    )

    cb.set_label(label, color="white", fontsize=9)

    return cb



# PARAMETERS


M = 150

theta = np.linspace(-np.pi, np.pi, M)

T1, T2 = np.meshgrid(theta, theta, indexing="ij")

alpha_val = 1.5

mu_val = np.array([0.5, -0.3])

ang_spec = np.array([
    0,
    np.pi / 2,
    np.pi / 4,
    3 * np.pi / 4
])

G_w = np.array([1.2, 0.8, 0.6, 0.6])

G_dir = np.column_stack([
    np.cos(ang_spec),
    np.sin(ang_spec)
])


# COMPUTE DENSITY


print("=" * 70)
print("Computing MWS density...")
print("=" * 70)

Z = mws_density(
    T1.ravel(),
    T2.ravel(),
    alpha=alpha_val,
    mu=mu_val,
    weights=G_w,
    directions=G_dir,
    N_trunc=25
)

Z = Z.reshape(M, M)

# Numerical safeguard
Z = np.clip(Z, 0, None)

print("Density range:")
print("Min =", np.min(Z))
print("Max =", np.max(Z))


# MARGINALS


marg1 = np.mean(Z, axis=1) * (2 * np.pi)
marg2 = np.mean(Z, axis=0) * (2 * np.pi)


