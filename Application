# SECTION 1 — DATA LOADING


def load_protein(path):
    df   = pd.read_csv(path, sep=r"\s+", index_col=0, header=0)
    df   = df.iloc[:, :2]
    df.columns = ["phi", "psi"]
    data = df.values.astype(float)
    return (data + np.pi) % (2 * np.pi) - np.pi


def load_rna(path):
    df          = pd.read_csv(path, sep=r"\s+", index_col=0, header=0)
    angle_cols  = df.columns[:7]
    data        = df[angle_cols].values.astype(float)
    data        = (data + np.pi) % (2 * np.pi) - np.pi
    true_labels = df.iloc[:, 7].values.astype(int)
    return data, true_labels



# SECTION 2 — UNIVARIATE MWS DENSITY  (Fourier series)


def d_mws1(theta, alpha, mu, gamma, N=N_FOURIER):
    
    theta = np.asarray(theta, float).ravel()
    ks    = np.arange(-N, N + 1, dtype=float)
    # CF moduli: exp(-gamma * |k|^alpha),  k=0 term = 1
    cf    = np.exp(-gamma * np.abs(ks) ** alpha)
    phase = np.outer(theta - mu, ks)          # (n, 2N+1)
    dens  = (cf[np.newaxis, :] * np.cos(phase)).sum(axis=1) / (2 * np.pi)
    return np.clip(dens, 1e-300, None)


def loglik_mws1(theta, alpha, mu, gamma):
    
    return float(np.sum(np.log(d_mws1(theta, alpha, mu, gamma))))




# SECTION 3 — HELPER UTILITIES


def circular_mean(theta):
    
    return float(np.arctan2(np.mean(np.sin(theta)), np.mean(np.cos(theta))))


def wrap_angle(a):
    
    return float((float(a) + np.pi) % (2 * np.pi) - np.pi)


def _loglog_wols(phi_abs, ks):
    
    
    ks      = np.asarray(ks, float)
    phi_abs = np.clip(phi_abs, 1e-12, 1 - 1e-12)
    y       = np.log(-np.log(phi_abs))          # log(-log|phi(k)|)
    x       = np.log(ks)                         # log(k)
    w       = 1.0 / ks                           # weights
    # weighted OLS: [intercept, slope] where x variable is log(k)
    W       = np.diag(w)
    X       = np.column_stack([np.ones_like(x), x])
    b       = np.linalg.lstsq(W @ X, W @ y, rcond=None)[0]
    gamma_hat = float(np.exp(b[0]))
    alpha_hat = float(np.clip(b[1], 0.15, 1.95))
    return alpha_hat, gamma_hat



# SECTION 4 — FIVE UNIVARIATE ESTIMATORS

#  4.1  GMM-CF
def GMM_cf_mws1(theta):
    theta   = np.asarray(theta, float)
    ks      = np.arange(1, K_CF + 1)
    phi_abs = np.array([np.abs(np.mean(np.exp(1j * k * theta))) for k in ks])
    alpha_hat, gamma_hat = _loglog_wols(phi_abs, ks)
    mu_hat   = circular_mean(theta)
    return np.array([alpha_hat, mu_hat, gamma_hat])


#  4.2  CF Minimum Distance Estimator 
def cf_mde_mws1(theta):
    theta   = np.asarray(theta, float)
    ks      = np.arange(1, K_CF + 1)
    phi_hat = np.array([np.mean(np.exp(1j * k * theta)) for k in ks])
    phi_abs = np.clip(np.abs(phi_hat), 1e-12, 1 - 1e-12)
    alpha_hat, gamma_hat = _loglog_wols(phi_abs, ks)
    mu_hat   = float(np.angle(phi_hat[0]))
    return np.array([alpha_hat, mu_hat, gamma_hat])


#  4.3  MLE via Nelder-Mead 
def mle_mws1(theta, init=None, N=N_FOURIER):
    theta = np.asarray(theta, float)
    if init is None:
        init = GMM_cf_mws1(theta)

    def itr(q):
        return np.array([0.1 + 1.9 * float(expit(q[0])),
                         float(q[1]),
                         float(np.exp(q[2]))])

    def tr(p):
        return np.array([np.log((p[0] - 0.1) / (2.0 - p[0])),
                         p[1],
                         np.log(max(p[2], 1e-8))])

    def neg_ll(q):
        p = itr(q)
        if abs(p[0] - 1.0) < 0.05:
            return 1e8
        return -float(np.sum(np.log(d_mws1(theta, p[0], p[1], p[2], N=N))))

    q0  = tr(init)
    res = minimize(neg_ll, q0, method="Nelder-Mead",
                   options={"maxiter": 3000, "xatol": 1e-5, "fatol": 1e-5})
    p   = itr(res.x)
    return np.array([p[0], wrap_angle(p[1]), p[2]])


# 4.4  EM Algorithm 
def em_mws1(theta, max_iter=80, tol=1e-5, init=None):
    theta = np.asarray(theta, float)
    if init is None:
        init = GMM_cf_mws1(theta)
    alpha, mu, gamma = float(init[0]), float(init[1]), float(init[2])

    def _ev(t_i, alp, m, g, N=15):
        ks  = np.concatenate([np.arange(-N, 0), np.arange(1, N + 1)])
        phi = np.exp(1j * ks * m - g * np.abs(ks) ** alp)
        lam = alp / (np.abs(ks) ** alp * g + 1e-15)
        ei  = np.exp(-1j * ks * t_i)
        num = float(np.real(np.sum(lam * phi * ei)))
        den = float(np.real(np.sum(phi * ei))) + 1.0 / (2 * np.pi)
        return max(num / (den + 1e-15), 0.01)

    prev_ll = -np.inf
    for _ in range(max_iter):
        vt    = np.array([_ev(t, alpha, mu, gamma) for t in theta])
        vt    = np.clip(vt, 0.01, None)
        mu    = circular_mean(theta)
        phi1  = max(float(np.abs(np.mean(np.exp(1j * theta)))), 1e-10)
        gamma = max(-np.log(phi1) / (1.0 ** alpha), 1e-4)

        def _neg_prof(a):
            if a <= 0.10 or a >= 1.95 or abs(a - 1.0) < 0.05:
                return 1e8
            return -float(np.sum(np.log(d_mws1(theta, a, mu, gamma, N=15))))

        res_a  = minimize_scalar(_neg_prof, bounds=(0.2, 1.95), method="bounded")
        alpha  = float(res_a.x)
        curr_ll = -_neg_prof(alpha)
        if abs(curr_ll - prev_ll) < tol:
            break
        prev_ll = curr_ll

    return np.array([alpha, wrap_angle(mu), gamma])


# 4.5  Nested EM 
def nested_em_mws1(theta, max_outer=30, tol=1e-5, init=None):
    theta = np.asarray(theta, float)
    if init is None:
        init = GMM_cf_mws1(theta)
    alpha, mu, gamma = float(init[0]), float(init[1]), float(init[2])

    def _inner(a):
        m    = circular_mean(theta)
        phis = np.array([
            max(float(np.abs(np.mean(np.exp(1j * k * theta)))), 1e-10)
            for k in range(1, K_CF + 1)
        ])
        g = max(float(np.mean(-np.log(phis) / np.arange(1, K_CF + 1) ** a)), 1e-4)
        return m, g

    prev_ll = -np.inf
    for _ in range(max_outer):
        def _neg_profile(a):
            if a <= 0.15 or a >= 1.95 or abs(a - 1.0) < 0.05:
                return 1e8
            m, g = _inner(a)
            return -float(np.sum(np.log(d_mws1(theta, a, m, g, N=15))))

        res_a   = minimize_scalar(_neg_profile, bounds=(0.2, 1.95), method="bounded")
        alpha   = float(res_a.x)
        mu, gamma = _inner(alpha)
        curr_ll = float(np.sum(np.log(d_mws1(theta, alpha, mu, gamma, N=15))))
        if abs(curr_ll - prev_ll) < tol:
            break
        prev_ll = curr_ll

    return np.array([alpha, wrap_angle(mu), gamma])



# SECTION 5 — FIT ALL METHODS ON ONE MARGINAL


ESTIMATORS = {
    "GMM-CF":    GMM_cf_mws1,
    "CF-MDE":    cf_mde_mws1,
    "MLE":       mle_mws1,
    "EM":        em_mws1,
    "Nested-EM": nested_em_mws1,
}


def fit_all_methods(theta):
    
    results = {}
    for name, fn in ESTIMATORS.items():
        t0 = time.time()
        try:
            p   = fn(theta)
            ll  = loglik_mws1(theta, p[0], p[1], p[2])
        except Exception:
            p   = np.array([np.nan, np.nan, np.nan])
            ll  = np.nan
        elapsed = time.time() - t0
        results[name] = {"alpha": p[0], "mu": p[1], "gamma": p[2],
                         "loglik": ll, "time": elapsed}
    return results


def fit_dataset(data, col_names):
    
    out = {}
    n, d = data.shape
    for j in range(d):
        cname = col_names[j] if j < len(col_names) else f"dim{j}"
        print(f"    dim {j+1}/{d}  ({cname})")
        out[cname] = fit_all_methods(data[:, j])
    return out



# SECTION 6 — STABILITY ANALYSIS (Table 1 analog)


def stability_analysis(theta, col_label="dim"):
    
    
    base = {}
    for name, fn in ESTIMATORS.items():
        try:
            p = fn(theta)
        except Exception:
            p = np.array([np.nan, np.nan, np.nan])
        base[name] = p

    start_labels = ["GMM-CF-init", "CF-MDE-init", "MLE-init", "EM-init"]
    start_params = [base["GMM-CF"], base["CF-MDE"], base["MLE"], base["EM"]]

    rows = []
    for slabel, sinit in zip(start_labels, start_params):
        row = {"start": slabel}
        for mname, fn in ESTIMATORS.items():
            try:
                p  = fn(theta, init=sinit) if "init" in fn.__code__.co_varnames else fn(theta)
                ll = loglik_mws1(theta, p[0], p[1], p[2])
            except Exception:
                ll = np.nan
            row[mname] = round(ll, 2)
        rows.append(row)

    return pd.DataFrame(rows).set_index("start")



# SECTION 7 — PLOTTING HELPERS


def _pi_axes(ax):
    ax.set_xticks(PI_TICKS); ax.set_xticklabels(PI_LABELS, fontsize=7)
    ax.set_yticks(PI_TICKS); ax.set_yticklabels(PI_LABELS, fontsize=7)
    ax.set_xlim(-np.pi, np.pi); ax.set_ylim(-np.pi, np.pi)
    ax.axhline(0, color="#bbb", lw=0.4, ls="--")
    ax.axvline(0, color="#bbb", lw=0.4, ls="--")


def _save(fig, name):
    path = os.path.join(OUTPUT_DIR, name)
    fig.savefig(path, dpi=150, bbox_inches="tight", facecolor=BG)
    plt.close(fig)
    print(f"  Saved: {name}")


def _confidence_ellipse(mu1, mu2, cov2x2, ax, n_std=2.448, **kwargs):
    
    try:
        vals, vecs = np.linalg.eigh(cov2x2)
        vals  = np.maximum(vals, 1e-12)
        angle = np.degrees(np.arctan2(vecs[1, -1], vecs[0, -1]))
        w, h  = 2 * n_std * np.sqrt(vals)
        ellip = Ellipse(xy=(mu1, mu2), width=w, height=h, angle=angle, **kwargs)
        ax.add_patch(ellip)
    except Exception:
        pass



