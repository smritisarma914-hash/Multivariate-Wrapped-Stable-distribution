# SECTION 10 — CORRELATION HEAT-MAP HELPER


def _circular_corr(x, y, mx, my):
    """JS circular correlation between two angle arrays."""
    xi = x - mx; yi = y - my
    num = np.sum(np.sin(xi) * np.sin(yi))
    den = np.sqrt(np.sum(np.sin(xi)**2) * np.sum(np.sin(yi)**2))
    if den < 1e-12:
        return 0.0
    return float(num / den)


def _plot_correlation_heatmap(data, mus, method_name, d, fname):
    
    corr = np.eye(d)
    for i in range(d):
        for j in range(i + 1, d):
            c = _circular_corr(data[:, i], data[:, j], mus[i], mus[j])
