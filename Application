# SECTION 14 — MWS CORE FUNCTIONS

K_TRUNC    = 10
def mws_density_1d(x, alpha, mu, sigma, K=K_TRUNC):
    
    k       = np.arange(-K, K + 1)
    phi_k   = np.exp(-np.abs(sigma * k) ** alpha)      # CF moduli
    phase   = np.outer(np.asarray(x) - mu, k)          # (n, 2K+1)
    density = (phi_k[np.newaxis, :] * np.cos(phase)).sum(axis=1) / (2 * np.pi)
    return np.clip(density, 1e-300, None)


def mws_loglik(theta_params, data, K=K_TRUNC):
    
    n, d   = data.shape
    alpha  = np.clip(theta_params[0], 0.3, 2.0)
    mu     = theta_params[1:1 + d]
    sigma  = np.exp(theta_params[1 + d:1 + 2 * d])
    ll     = 0.0
    for j in range(d):
        ll += np.sum(np.log(mws_density_1d(data[:, j], alpha, mu[j], sigma[j], K)))
    return ll


def fit_mws(data, init_alpha=1.5, K=K_TRUNC, maxiter=600):
    
    n, d   = data.shape
    mu0    = np.arctan2(np.mean(np.sin(data), axis=0),
                        np.mean(np.cos(data), axis=0))
    x0     = np.concatenate([[init_alpha], mu0, np.zeros(d)])
    bounds = [(0.3, 2.0)] + [(-np.pi, np.pi)] * d + [(-3, 2)] * d
    result = minimize(
        lambda x: -mws_loglik(x, data, K),
        x0, method="L-BFGS-B", bounds=bounds,
        options={"maxiter": maxiter, "ftol": 1e-9}
    )
    return result


def mws_params(res, d):
    
    alpha = res.x[0]
    mu    = res.x[1:1 + d]
    sigma = np.exp(res.x[1 + d:1 + 2 * d])
    return alpha, mu, sigma

# SECTION 15 — COMPARISON MODELS


def fit_vonmises(data):
    
    n, d = data.shape
    mus, kappas, ll = [], [], 0.0
    for j in range(d):
        mu_j  = np.arctan2(np.mean(np.sin(data[:, j])),
                           np.mean(np.cos(data[:, j])))
        Rbar  = float(np.abs(np.mean(np.exp(1j * data[:, j]))))
        if   Rbar < 0.53: kappa = 2*Rbar + Rbar**3 + 5/6*Rbar**5
        elif Rbar < 0.85: kappa = -0.4 + 1.39*Rbar + 0.43/(1 - Rbar)
        else:             kappa = 1 / (Rbar**3 - 4*Rbar**2 + 3*Rbar)
        kappa = max(kappa, 0.01)
        mus.append(mu_j); kappas.append(kappa)
        ll += float(np.sum(vonmises.logpdf(data[:, j], kappa, loc=mu_j)))
    return np.array(mus), np.array(kappas), ll


def wc_logpdf(x, rho, mu):
    
    xc = (x - mu + np.pi) % (2 * np.pi) - np.pi
    return (np.log(1 - rho**2) - np.log(2*np.pi)
            - np.log(1 + rho**2 - 2*rho*np.cos(xc)))


def fit_wrapped_cauchy(data):
    
    n, d = data.shape
    mus, rhos, ll = [], [], 0.0
    for j in range(d):
        mu_j  = np.arctan2(np.mean(np.sin(data[:, j])),
                           np.mean(np.cos(data[:, j])))
        rho_j = float(np.clip(np.abs(np.mean(np.exp(1j * data[:, j]))), 0.001, 0.999))
        mus.append(mu_j); rhos.append(rho_j)
        ll += float(np.sum(wc_logpdf(data[:, j], rho_j, mu_j)))
    return np.array(mus), np.array(rhos), ll



# SECTION 16 — RAMACHANDRAN PLOT  


def plot_ramachandran(data, alpha, mu, sigma, col_names, title, fname):
    
    phi_data = data[:, 0]
    psi_data = data[:, 1]

    # Evaluate fitted MWS density on a 2-D grid (product of marginals)
    G  = 100
    gv = np.linspace(-np.pi, np.pi, G)
    GX, GY = np.meshgrid(gv, gv, indexing="ij")
    d1 = mws_density_1d(GX.ravel(), alpha, mu[0], sigma[0]).reshape(G, G)
    d2 = mws_density_1d(GY.ravel(), alpha, mu[1], sigma[1]).reshape(G, G)
    Z  = d1 * d2    # joint density under diagonal spectral measure

    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5), facecolor=BG)
    fig.suptitle(title, fontsize=13, fontweight="bold", y=1.01)

    # ── Left: scatter + fitted MWS contours ──────────────────────────────────
    ax = axes[0]
    ax.set_facecolor(BG)
    ax.scatter(phi_data, psi_data, s=8, alpha=0.4, c="#334155", rasterized=True)
    cs = ax.contour(GX, GY, Z, levels=8, cmap="Reds", linewidths=1.4)
    ax.clabel(cs, inline=True, fontsize=6, fmt="%.3f")
    ax.set_xlabel(col_names[0], fontsize=11)
    ax.set_ylabel(col_names[1], fontsize=11)
    
    _pi_axes(ax)
    ax.spines[["top","right"]].set_visible(False)

    # ── Right: hexbin density + fitted MWS contours ──────────────────────────
    ax2 = axes[1]
    ax2.set_facecolor(BG)
    h  = ax2.hexbin(phi_data, psi_data, gridsize=35, cmap="YlOrRd",
                    mincnt=1, extent=(-np.pi, np.pi, -np.pi, np.pi))
    plt.colorbar(h, ax=ax2, label="count", shrink=0.85)
    ax2.contour(GX, GY, Z, levels=8, cmap="Blues", linewidths=1.1, alpha=0.85)
    ax2.set_xlabel(col_names[0], fontsize=11)
    ax2.set_ylabel(col_names[1], fontsize=11)
    
    _pi_axes(ax2)
    ax2.spines[["top","right"]].set_visible(False)

    plt.tight_layout()
    _save(fig, fname)



# SECTION 17 — MARGINAL PDFs  


def plot_marginals(data, alpha, mu, sigma, col_names,
                   true_labels=None, title="", fname="marginals.png"):
    
    n, d = data.shape
    ncols = min(d, 4)
    nrows = int(np.ceil(d / ncols))

    # Fit comparison models
    mus_vm,  kaps_vm,  _ = fit_vonmises(data)
    mus_wc,  rhos_wc,  _ = fit_wrapped_cauchy(data)

    gv = np.linspace(-np.pi, np.pi, 400)

    fig, axes = plt.subplots(nrows, ncols,
                             figsize=(4.2*ncols, 3.3*nrows),
                             facecolor=BG)
    axes = np.array(axes).reshape(-1)

    for j in range(d):
        ax = axes[j]
        ax.set_facecolor("white")

        if true_labels is not None:
            # Colour histograms by class (RNA analysis)
            for cls in sorted(np.unique(true_labels)):
                mask = true_labels == cls
                ax.hist(data[mask, j], bins=30, density=True, alpha=0.45,
                        color=CLASS_COLORS[cls], label=CLASS_LABELS[cls])
        else:
            ax.hist(data[:, j], bins=30, density=True, alpha=0.5,
                    color="#94a3b8", edgecolor="white")

        # Fitted MWS density
        mws_d = mws_density_1d(gv, alpha, mu[j], sigma[j])
        ax.plot(gv, mws_d, color="#dc2626", lw=2.2,
                label=rf"MWS ($\alpha$={alpha:.2f})")

        # Von Mises
        vm_d  = vonmises.pdf(gv, kaps_vm[j], loc=mus_vm[j])
        ax.plot(gv, vm_d, color="#2563eb", lw=1.8, ls="--", label="von Mises")

        # Wrapped Cauchy
        wc_d  = np.exp(wc_logpdf(gv, rhos_wc[j], mus_wc[j]))
        ax.plot(gv, wc_d, color="#16a34a", lw=1.8, ls=":", label="Wr. Cauchy")

        ax.set_title(col_names[j], fontsize=10)
        ax.set_xlim(-np.pi, np.pi)
        ax.set_xticks([-np.pi, 0, np.pi])
        ax.set_xticklabels([r"$-\pi$", r"$0$", r"$\pi$"], fontsize=7)
        ax.tick_params(labelsize=7)
        ax.spines[["top","right"]].set_visible(False)
        if j == 0:
            ax.legend(fontsize=6.5, framealpha=0.8, loc="upper right")

    for j in range(d, len(axes)):
        fig.delaxes(axes[j])

    fig.suptitle(title, fontsize=12, fontweight="bold", y=1.01)
    plt.tight_layout()
    _save(fig, fname)



